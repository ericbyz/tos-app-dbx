# DBX web service environment (sourced by systemd EnvironmentFile)

# Local listen port; TOS nginx proxies /dbx/ -> 127.0.0.1:18224 (see nginx/dbx.conf)
DBX_PORT=18224

# Public base path: dbx-web serves UI/API under /dbx so it can live behind the
# TOS platform nginx route (iframe embedded mode, config.ini path=/dbx/)
DBX_PUBLIC_BASE_PATH=/dbx

# Package root (mirrors upstream launcher); binary has the frontend embedded
DBX_PACKAGE_ROOT=/usr/local/dbx

# Data directory: holds dbx.db and the managed key .dbx/secret.key
DBX_DATA_DIR=/var/lib/dbx

# Optional: set a web login password (recommended; see upstream README).
#DBX_PASSWORD=changeme
